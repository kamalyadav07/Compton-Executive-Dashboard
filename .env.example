# =====================================================================
# Compton Dashboard - Frontend Client Environment Template (.env.example)
# =====================================================================

# Backend API Server URL (Bitrix CRM webhook & Gemini API keys live on server only)
# In local development, the backend defaults to http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# Google Sheets URLs for Project Delivery & Order Tracking
VITE_PROJECTS_SHEET_URL=https://docs.google.com/spreadsheets/d/your_project_sheet_id/edit
VITE_ORDERS_SHEET_URL=https://docs.google.com/spreadsheets/d/your_orders_sheet_id/edit
