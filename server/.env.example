# =====================================================================
# Compton Dashboard - Backend Server Environment Template (server/.env.example)
# =====================================================================

# PostgreSQL Connection String (Supabase, Neon, AWS RDS, or Local Postgres with pgvector)
# Example Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example Neon: postgresql://[user]:[password]@[endpoint-pooler].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Bitrix24 CRM REST Webhook Base URL (server-side only, never sent to browser)
# Example: https://your-company.bitrix24.in/rest/<user_id>/<webhook_token>/
BITRIX_WEBHOOK_URL=

# Google Gemini AI API Key (server-side only, from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini Model Identifier (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Comma-separated list of allowed CORS origins for the frontend client
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Port the backend Express server listens on (default: 4000)
PORT=4000

# Background Bitrix sync interval in milliseconds (default: 300000 = 5 minutes)
SYNC_INTERVAL_MS=300000
