{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "server/cached_bitrix_deals.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
