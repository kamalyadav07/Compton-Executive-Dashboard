{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/**,public/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
